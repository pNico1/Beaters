<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scores_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_bottom"
    android:padding="24dp"
    tools:context=".ScoresActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scores_title"
        android:textColor="@color/hud_text"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Easy -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/difficulty_easy"
            android:textColor="@color/note_green"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />
        <TextView
            android:id="@+id/scoresEasy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hud_text"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="4dp" />

        <!-- Medium -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/difficulty_medium"
            android:textColor="@color/btn_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />
        <TextView
            android:id="@+id/scoresMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hud_text"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="4dp" />

        <!-- Hard -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/difficulty_hard"
            android:textColor="@color/note_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />
        <TextView
            android:id="@+id/scoresHard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hud_text"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="@string/scores_back"
        android:backgroundTint="@color/btn_primary"
        android:textColor="@color/btn_primary_text"
        android:layout_marginBottom="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
